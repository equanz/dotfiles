{
    "keybindings": [
        {
            "key": "ctrl+x ctrl+f",
            "command": "equanz.file.find",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+l",
            "command": "equanz.file.parentDirectory",
            "when": "equanz.filePicker && inQuickInput"
        },
        {
            "key": "ctrl+l",
            "command": "equanz.project.parentDirectory",
            "when": "equanz.projectDirectoryPicker && inQuickInput"
        },
        {
            "key": "ctrl+j",
            "command": "equanz.project.enterDirectory",
            "when": "equanz.projectDirectoryPicker && inQuickInput"
        },
        {
            "key": "ctrl+x b",
            "command": "equanz.buffer.switch",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+x n",
            "command": "workbench.action.nextEditorInGroup",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+x p",
            "command": "workbench.action.previousEditorInGroup",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+x k",
            "command": "equanz.buffer.kill",
            "when": "!terminalFocus"
        },
        {
            "key": "y",
            "command": "equanz.buffer.confirmKill",
            "when": "equanz.bufferKillConfirm && inQuickInput"
        },
        {
            "key": "n",
            "command": "equanz.buffer.cancelKill",
            "when": "equanz.bufferKillConfirm && inQuickInput"
        },
        {
            "key": "ctrl+x o",
            "command": "workbench.action.focusNextGroup",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+x 2",
            "command": "workbench.action.splitEditorDown",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+x 3",
            "command": "workbench.action.splitEditorRight",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+x 0",
            "command": "workbench.action.closeGroup",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+x 1",
            "command": "workbench.action.joinAllGroups",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+x 5",
            "command": "equanz.frame.menu",
            "when": "!terminalFocus"
        },
        {
            "key": "2",
            "command": "equanz.frame.new",
            "when": "equanz.frameMenu && inQuickInput"
        },
        {
            "key": "0",
            "command": "equanz.frame.close",
            "when": "equanz.frameMenu && inQuickInput"
        },
        {
            "key": "ctrl+x ctrl+c",
            "command": "workbench.action.quit",
            "when": "!terminalFocus"
        },
        {
            "key": "alt+x",
            "command": "workbench.action.showCommands",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+p",
            "command": "quickInput.previous",
            "when": "inQuickInput && !migemo-isearch.inIsearchMode"
        },
        {
            "key": "ctrl+n",
            "command": "quickInput.next",
            "when": "inQuickInput && !migemo-isearch.inIsearchMode"
        },
        {
            "key": "ctrl+n",
            "command": "workbench.action.interactivePlayground.arrowDown",
            "when": "interactivePlaygroundFocus && !editorTextFocus"
        },
        {
            "key": "ctrl+p",
            "command": "workbench.action.interactivePlayground.arrowUp",
            "when": "interactivePlaygroundFocus && !editorTextFocus"
        },
        {
            "key": "ctrl+j",
            "command": "quickInput.accept",
            "when": "inQuickInput && !migemo-isearch.inIsearchMode && !equanz.projectDirectoryPicker"
        },
        {
            "key": "ctrl+g",
            "command": "quickInput.hide",
            "when": "inQuickInput"
        },
        {
            "key": "ctrl+g",
            "command": "closeFindWidget",
            "when": "findWidgetVisible"
        },
        {
            "key": "alt+;",
            "command": "editor.action.commentLine",
            "when": "editorTextFocus && editorHasSelection && !editorReadonly"
        },
        {
            "key": "ctrl+s",
            "command": "-emacs-mcx.isearchForward",
            "when": "!findInputFocussed"
        },
        {
            "key": "ctrl+r",
            "command": "-emacs-mcx.isearchBackward",
            "when": "!findInputFocussed"
        },
        {
            "key": "ctrl+c ctrl+f",
            "command": "workbench.action.quickOpen",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+c ctrl+d",
            "command": "goToFolder.open",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+c ctrl+a",
            "command": "equanz.project.add",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+c p",
            "command": "equanz.project.menu",
            "when": "!terminalFocus"
        },
        {
            "key": "a",
            "command": "equanz.project.addFromMenu",
            "when": "equanz.projectMenu && inQuickInput"
        },
        {
            "key": "p",
            "command": "equanz.project.switchFromMenu",
            "when": "equanz.projectMenu && inQuickInput"
        },
        {
            "key": "d",
            "command": "equanz.project.deleteFromMenu",
            "when": "equanz.projectMenu && inQuickInput"
        },
        {
            "key": "ctrl+c shift+p",
            "command": "workbench.view.extension.project-manager",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+c ctrl+g",
            "command": "workbench.action.quickTextSearch",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+c o",
            "command": "workbench.view.explorer",
            "when": "!terminalFocus"
        },
        {
            "key": "enter",
            "command": "list.select",
            "when": "filesExplorerFocus && !inputFocus"
        },
        {
            "key": "ctrl+j",
            "command": "list.select",
            "when": "filesExplorerFocus && !inputFocus"
        },
        {
            "key": "ctrl+c ctrl+n",
            "command": "workbench.files.action.createFileFromExplorer",
            "when": "filesExplorerFocus"
        },
        {
            "key": "ctrl+c ctrl+m",
            "command": "workbench.files.action.createFolderFromExplorer",
            "when": "filesExplorerFocus"
        },
        {
            "key": "ctrl+c ctrl+k",
            "command": "equanz.explorer.moveToTrash",
            "when": "filesExplorerFocus"
        },
        {
            "key": "y",
            "command": "equanz.explorer.confirmTrash",
            "when": "equanz.trashConfirm && inQuickInput"
        },
        {
            "key": "n",
            "command": "equanz.explorer.cancelTrash",
            "when": "equanz.trashConfirm && inQuickInput"
        },
        {
            "key": "shift+y",
            "command": "equanz.explorer.confirmTrash",
            "when": "equanz.trashConfirm && inQuickInput"
        },
        {
            "key": "shift+n",
            "command": "equanz.explorer.cancelTrash",
            "when": "equanz.trashConfirm && inQuickInput"
        },
        {
            "key": "y",
            "command": "equanz.project.confirmDelete",
            "when": "equanz.projectDeleteConfirm && inQuickInput"
        },
        {
            "key": "n",
            "command": "equanz.project.cancelDelete",
            "when": "equanz.projectDeleteConfirm && inQuickInput"
        },
        {
            "key": "shift+y",
            "command": "equanz.project.confirmDelete",
            "when": "equanz.projectDeleteConfirm && inQuickInput"
        },
        {
            "key": "shift+n",
            "command": "equanz.project.cancelDelete",
            "when": "equanz.projectDeleteConfirm && inQuickInput"
        },
        {
            "key": "ctrl+c ctrl+r",
            "command": "renameFile",
            "when": "filesExplorerFocus"
        },
        {
            "key": "ctrl+c ctrl+y",
            "command": "runCommands",
            "args": {
                "commands": [
                    "filesExplorer.copy",
                    "filesExplorer.paste"
                ]
            },
            "when": "filesExplorerFocus"
        },
        {
            "key": "space",
            "command": "list.toggleExpand",
            "when": "filesExplorerFocus"
        },
        {
            "key": "ctrl+c t",
            "command": "workbench.action.terminal.toggleTerminal",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+g",
            "command": "workbench.action.focusActiveEditorGroup",
            "when": "terminalFocus"
        },
        {
            "key": "ctrl+c e",
            "command": "workbench.actions.view.problems",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+c ]",
            "command": "editor.action.marker.nextInFiles",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+c [",
            "command": "editor.action.marker.prevInFiles",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+c ctrl+n",
            "command": "editor.action.dirtydiff.next",
            "when": "editorTextFocus"
        },
        {
            "key": "ctrl+c ctrl+p",
            "command": "editor.action.dirtydiff.previous",
            "when": "editorTextFocus"
        },
        {
            "key": "ctrl+c ctrl+v",
            "command": "git.openChange",
            "when": "editorTextFocus"
        },
        {
            "key": "ctrl+c v",
            "command": "equanz.markdown.previewToSide",
            "when": "editorLangId == markdown && editorTextFocus"
        },
        {
            "key": "ctrl+c shift+v",
            "command": "markdown.reopenAsPreview",
            "when": "editorLangId == markdown && editorTextFocus"
        },
        {
            "key": "ctrl+c h",
            "command": "equanz.keymap.show",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+c h",
            "command": "equanz.keymap.showExplorer",
            "when": "filesExplorerFocus && !inputFocus"
        },
        {
            "key": "ctrl+shift+n",
            "command": "workbench.action.increaseViewHeight",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+shift+p",
            "command": "workbench.action.decreaseViewHeight",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+shift+f",
            "command": "workbench.action.increaseViewWidth",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+shift+b",
            "command": "workbench.action.decreaseViewWidth",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+j",
            "command": "acceptSelectedSuggestion",
            "when": "suggestWidgetVisible && textInputFocus"
        },
        {
            "key": "ctrl+o",
            "command": "notifications.focusToasts",
            "when": "notificationToastsVisible"
        },
        {
            "key": "ctrl+n",
            "command": "notifications.focusNextToast",
            "when": "notificationFocus && notificationToastsVisible"
        },
        {
            "key": "ctrl+p",
            "command": "notifications.focusPreviousToast",
            "when": "notificationFocus && notificationToastsVisible"
        },
        {
            "key": "ctrl+j",
            "command": "notification.acceptPrimaryAction",
            "when": "notificationFocus || notificationCenterVisible"
        },
        {
            "key": "ctrl+g",
            "command": "notifications.hideToasts",
            "when": "notificationFocus || notificationToastsVisible"
        },
        {
            "key": "ctrl+g",
            "command": "notifications.hideList",
            "when": "notificationCenterVisible"
        },
        {
            "key": "ctrl+k",
            "command": "notification.clear",
            "when": "notificationFocus"
        },
        {
            "key": "ctrl+c n",
            "command": "notifications.showList",
            "when": "!terminalFocus"
        },
        {
            "key": "ctrl+c m",
            "command": "equanz.notes.open",
            "when": "!terminalFocus"
