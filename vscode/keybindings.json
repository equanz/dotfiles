    {
        "key": "ctrl+c ctrl+r",
        "command": "renameFile",
        "when": "filesExplorerFocus"
    },
    {
        "key": "ctrl+c ctrl+y",
        "command": "runCommands",
        "args": {
            "commands": [
                "filesExplorer.copy",
                "filesExplorer.paste"
            ]
        },
        "when": "filesExplorerFocus"
    },
    {
        "key": "space",
        "command": "list.toggleExpand",
        "when": "filesExplorerFocus"
    },
    {
        "key": "ctrl+c t",
